# 복사해서 .env 로 사용하세요. 비밀값은 절대 커밋하지 마세요 (.env 는 .gitignore 대상).
PORT=3001

# 필수(공개/운영): 무작위 긴 문자열. 예) node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 고객 연락처 암호화 키. 운영 중 변경하면 기존 데이터를 복호화할 수 없으니 백업 후 절차대로 교체하세요.
APP_KEY=
NAVER_WEBHOOK_SECRET=

# 플랫폼 관리자 계정(/admin.html). 서버 시작 시 생성/갱신됩니다. 비밀번호는 10자 이상.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# 공개 도메인용 TLS 인증서(없으면 certs/cert.pem, certs/key.pem 의 로컬 mkcert 인증서 사용)
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
